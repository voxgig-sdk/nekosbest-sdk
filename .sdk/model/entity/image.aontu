# Entity: image

main: kit: entity: image: {

  alias: field: {}

  fields: {
    categories: {
      h: "Categories"
      n: "categories"
      r: false
      sh: "Total number of categories"
      t: "`$INTEGER`"
    }
    endpoints: {
      h: "Endpoints"
      n: "endpoints"
      r: false
      sh: "Array of available category names"
      t: "`$ARRAY`"
    }
    total_gifs: {
      h: "Total Gifs"
      n: "total_gifs"
      r: false
      sh: "Total number of GIFs available"
      t: "`$INTEGER`"
    }
    total_images: {
      h: "Total Images"
      n: "total_images"
      r: false
      sh: "Total number of images available"
      t: "`$INTEGER`"
    }
  }

  name: "image"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /endpoints"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/endpoints"
          s: [
            {
              lit: "endpoints"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.endpoints`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /stats"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/stats"
          s: [
            {
              lit: "stats"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
