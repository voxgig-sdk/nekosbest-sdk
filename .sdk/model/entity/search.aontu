# Entity: search

main: kit: entity: search: {

  alias: field: {}

  fields: [
    {
      name: "anime_name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "artist_href"
      req: false
      type: "`$STRING`"
    }
    {
      name: "artist_name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "source_url"
      req: false
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      type: "`$STRING`"
    }
  ]

  name: "search"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "amount"
                orig: "amount"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "category"
                orig: "category"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "query"
                orig: "query"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/search"
          parts: [
            "search"
          ]
          select: {
            exist: [
              "amount"
              "category"
              "query"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
