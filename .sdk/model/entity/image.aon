# Entity: image

main: kit: entity: image: {

  alias: field: {}

  fields: [
    {
      name: "categories"
      req: false
      short: "Total number of categories"
      type: "`$INTEGER`"
    }
    {
      name: "endpoints"
      req: false
      short: "Array of available category names"
      type: "`$ARRAY`"
    }
    {
      name: "total_gifs"
      req: false
      short: "Total number of GIFs available"
      type: "`$INTEGER`"
    }
    {
      name: "total_images"
      req: false
      short: "Total number of images available"
      type: "`$INTEGER`"
    }
  ]

  name: "image"
  op: {
    list: {
      name: "list"
      points: [
        {
          contract: {
            id: "GET /endpoints"
            json: "{\"operationId\":\"getEndpoints\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"endpoints\":{\"summary\":\"Available endpoints\",\"value\":{\"endpoints\":[\"neko\",\"husbando\",\"kitsune\",\"waifu\",\"pat\",\"hug\",\"kiss\",\"slap\",\"cuddle\",\"bite\"]}}},\"schema\":{\"properties\":{\"endpoints\":{\"description\":\"Array of available category names\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Successful response with list of available endpoints\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/endpoints"
          segments: [
            {
              lit: "endpoints"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.endpoints`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          contract: {
            id: "GET /stats"
            json: "{\"operationId\":\"getStats\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"stats\":{\"summary\":\"API statistics\",\"value\":{\"categories\":48,\"total_gifs\":3000,\"total_images\":5000}}},\"schema\":{\"properties\":{\"categories\":{\"description\":\"Total number of categories\",\"type\":\"integer\"},\"total_gifs\":{\"description\":\"Total number of GIFs available\",\"type\":\"integer\"},\"total_images\":{\"description\":\"Total number of images available\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Successful response with API statistics\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/stats"
          segments: [
            {
              lit: "stats"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
