# Entity: image

main: kit: entity: image: {

  alias: field: {}

  fields: [
    {
      name: "categories"
      req: false
      short: "Total number of categories"
      type: "`$INTEGER`"
    }
    {
      name: "endpoints"
      req: false
      short: "Array of available category names"
      type: "`$ARRAY`"
    }
    {
      name: "total_gifs"
      req: false
      short: "Total number of GIFs available"
      type: "`$INTEGER`"
    }
    {
      name: "total_images"
      req: false
      short: "Total number of images available"
      type: "`$INTEGER`"
    }
  ]

  name: "image"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/endpoints"
          parts: [
            "endpoints"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.endpoints`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/stats"
          parts: [
            "stats"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
